{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git describe *)",
      "Bash(git branch)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push origin *)",
      "Bash(git tag *)",
      "Bash(git revert *)",
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(npx tsc *)",
      "Bash(npx next *)",
      "Bash(ls *)",
      "Edit",
      "Write"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(git rm *)",
      "Bash(mv *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git tag -d *)",
      "Bash(git push --delete *)",
      "Bash(git push origin --delete *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git stash drop *)",
      "Bash(find * -delete*)",
      "Bash(unlink *)",
      "Bash(curl *)",
      "Bash(python3 *)",
      "Bash(node *)",
      "Bash(pip3 install *)",
      "Bash(npx nanobanana *)",
      "Bash(npx nano-banana-mcp *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push origin --force*)",
      "Bash(git push origin -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Bash(git rebase *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/revisar-secretos.sh"
          }
        ]
      }
    ]
  }
}
